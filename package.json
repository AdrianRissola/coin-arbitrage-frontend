{
  "name": "coin-arbitrage-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.8",
    "@mui/icons-material": "^5.15.4",
    "@mui/material": "^5.15.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.1.3",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dotenv": "^0.1.3",
    "react-scripts": "^5.0.1",
    "sass": "^1.54.6",
    "util": "^0.12.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development && react-scripts start",
    "start": "npx cross-env NODE_ENV=production && react-scripts start",
    "build": "npx cross-env NODE_ENV=production && react-dotenv && react-scripts build",
    "test": "node test/frontend/run.cjs",
    "test:services": "node test/frontend/run.cjs --suite services",
    "test:ui": "node test/frontend/run.cjs --suite ui",
    "test:components": "node test/frontend/run.cjs --suite components",
    "test:all": "node test/frontend/run.cjs --suite all",
    "test:ci": "node test/frontend/run.cjs --suite all --coverage --detect-open-handles",
    "test:app": "node test/frontend/run.cjs --suite app",
    "test:lifecycle": "node test/frontend/run.cjs --suite lifecycle",
    "test:coverage": "node test/frontend/run.cjs --coverage",
    "test:handles": "node test/frontend/run.cjs --detect-open-handles",
    "test:lint": "eslint --no-cache --ext .js,.cjs src/test/frontend src/setupTests.js test/frontend",
    "test:security": "node --test test/security.test.cjs",
    "test:bootstrap": "node --test src/test/integration-contracts/bootstrap.test.cjs",
    "test:fixtures": "node src/test/integration-contracts/verify.cjs",
    "test:int": "node src/test/integration-contracts/run.cjs",
    "test:int:coverage": "node src/test/integration-contracts/run.cjs --coverage --detect-open-handles",
    "eject": "react-scripts eject"
  },
  "jest": {
    "testMatch": ["<rootDir>/src/test/frontend/**/*.test.js"],
    "globalSetup": "<rootDir>/test/frontend/support/require-runner.cjs",
    "collectCoverageFrom": ["src/**/*.{js,jsx}", "!src/**/*.test.js", "!src/setupTests.js", "!src/test/**"],
    "coverageReporters": ["json", "json-summary", "lcov", "text-summary"],
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!axios[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "html-loader": "^1.3.2",
    "html-webpack-plugin": "^4.3.0",
    "react-error-overlay": "^6.0.9"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false
  },
  "react-dotenv": {
    "whitelist": [
      "REACT_APP_API_REST_ENDPOINT",
      "REACT_APP_WEB_SOCKET_ENDPOINT"
    ]
  }
}
